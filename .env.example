# CivicOps Command safe environment template
# Copy to .env for local use. Never commit real keys.

# App/runtime
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
DEMO_MODE=true

# Band of Agents integration
BAND_API_KEY=
BAND_API_BASE_URL=https://app.thenvoi.com
# Optional: set Band:Mode=Live with the ASP.NET configuration form when the bridge is running.
Band__Mode=Simulation
Band__BridgeUrl=http://localhost:8787
Band__Workspace=civicops-command
Band__TickSeconds=2.5

# Optional AI/ML API unified model provider
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini

# Optional Featherless AI OpenAI-compatible provider
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Existing optional Gemini enrichment
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTINE_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash
GEMINI_AUTO_RUN_AGENT_PAGE=false
GEMINI_MANUAL_TEST_COOLDOWN_SECONDS=60
GEMINI_QUOTA_COOLDOWN_MINUTES=30
GEMINI_MODE=Hybrid

# Optional WhatsApp connector readiness
WHATSAPP_ENABLED=false
WHATSAPP_DEMO_MODE=true
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

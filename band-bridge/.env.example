# CivicOps Command — Band Bridge configuration
# Copy to .env (or export in your shell) before `npm start`.

# --- Single-identity mode -------------------------------------------------
# One Band API key (from your Band account). This identity creates each room
# and posts every agent message (prefixed with the agent name). Leave empty
# (and THENVOI_AGENT_KEYS empty) to run in stub mode.
THENVOI_API_KEY=
# (BAND_API_KEY is accepted as an alias for THENVOI_API_KEY.)
BAND_API_KEY=

# --- True multi-identity mode (optional) ----------------------------------
# Give each of the five CivicOps agents its OWN Band identity so they appear as
# five distinct members collaborating in one shared Band room. JSON map of the
# civic agent id -> that agent's Band API key. Any agent without its own key
# falls back to THENVOI_API_KEY.
#
# THENVOI_AGENT_KEYS={"agent.intake":"key1","agent.dispatch":"key2","agent.logistics":"key3","agent.monitor":"key4","agent.publicinfo":"key5"}
THENVOI_AGENT_KEYS=

# Band REST base URL (defaults to the hosted platform).
THENVOI_REST_URL=https://app.thenvoi.com
# BAND_API_BASE_URL is accepted as the submission-standard alias.
BAND_API_BASE_URL=https://app.thenvoi.com

# Label for the workspace the per-incident rooms live under.
BAND_WORKSPACE=civicops-command

# Port the bridge listens on (must match Band:BridgeUrl in the C# app).
PORT=8787

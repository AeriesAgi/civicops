# ── CivicOps Command — Environment Configuration ──────────────────
# Copy to .env and fill in your values: cp .env.example .env

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Database
DB_PASSWORD=civicops_secure_password_change_me

# Redis
REDIS_PASSWORD=redis_secure_password_change_me

# JWT — MUST be at least 32 characters (256 bits)
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars

# AI — Gemini API (get key at https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# Twilio SMS (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# RabbitMQ
RABBITMQ_USER=civicops
RABBITMQ_PASSWORD=rabbit_secure_password_change_me

# Grafana (observability profile)
GRAFANA_PASSWORD=admin

# Email / SMTP (optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=

@{
    ViewData["Title"] = "Judge Tour";
    var steps = new[] {
        new { Title="1. Band Dispatch", Link="/Band", Click="Launch the structural-fire scenario with auto-confirm enabled for a fast pass.", See="Five named agents coordinate through one incident room and close with a summary.", Why="Proves the Band of Agents core workflow.", Next="Home / product story" },
        new { Title="2. Home / product story", Link="/", Click="Read the hero and primary channel explanation.", See="Band dispatch, Citizen App / PWA and web reporting are clearly positioned.", Why="Frames CivicOps as a pilot-ready civic AI product.", Next="Report an issue" },
        new { Title="3. Report an issue", Link="/Home/Report", Click="Submit the app-first report form or review its fields.", See="A reference number, citizen response, routing and status link.", Why="Proves web/PWA reporting works without WhatsApp.", Next="Open Citizen App" },
        new { Title="4. Citizen App / PWA", Link="/citizen-app", Click="Open the phone-like app tiles.", See="Report, track, alerts, weather and resident profile paths.", Why="Shows the main citizen channel.", Next="Run AI agent" },
        new { Title="5. AI Agent Command Centre", Link="/Home/Agent", Click="Run each action button once.", See="Validation, department, priority, citizen response, alert recommendation and audit trail.", Why="Shows Gemini/fallback intelligence is event-triggered and quota-safe.", Next="Open dashboard" },
        new { Title="6. Dashboard/control room", Link="/Home/Dashboard", Click="Review stats, queues and high-priority reports.", See="A civic operations view for staff review.", Why="Shows routing has operational value.", Next="Track a reference" },
        new { Title="7. Incident/status lookup", Link="/Home/Lookup", Click="Enter a reference from a submitted ticket.", See="Status, department, timeline and latest update.", Why="Residents can self-serve status without calling staff.", Next="View alerts/weather" },
        new { Title="8. Alerts/weather", Link="/Home/Alerts", Click="Review alert cards, then open weather context.", See="Area, ward, severity and sandbox weather signals.", Why="Connects individual reports to public resilience messaging.", Next="Connector readiness" },
        new { Title="9. Connector readiness", Link="/Home/Connectors", Click="Review Gemini diagnostics and connector order.", See="Enabled/key-present/model/cooldown/fallback status without secrets.", Why="Demonstrates honest integration posture.", Next="Finish" }
    };
}
<div class="container py-4 civic-page">
    <section class="hero-panel mb-4">
        <span class="eyebrow">3–5 minute guided evaluation path</span>
        <h1 class="display-5">CivicOps judge tour</h1>
        <p class="lead">Follow this route from Band dispatch to intake, AI action, ticket tracking, control room, alerts, Citizen App and connector readiness.</p>
        <a class="btn btn-primary btn-lg" href="/Band">Begin with Band Dispatch</a>
    </section>
    <div class="row g-3">
        @for (var i = 0; i < steps.Length; i++)
        {
            var step = steps[i];
            var next = i + 1 < steps.Length ? steps[i + 1].Link : "/";
            <div class="col-lg-6">
                <div class="tour-step h-100">
                    <span class="badge bg-info mb-2">@step.Title</span>
                    <h2 class="h5"><a href="@step.Link">@step.Link</a></h2>
                    <p><strong>What to click:</strong> @step.Click</p>
                    <p><strong>What should happen:</strong> @step.See</p>
                    <p><strong>Why it matters:</strong> @step.Why</p>
                    <div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" href="@step.Link">Open step</a><a class="btn btn-outline-info" href="@next">Next step</a></div>
                </div>
            </div>
        }
    </div>
</div>
